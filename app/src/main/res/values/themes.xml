<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Schede (Generali / Admin) a tutta larghezza anche in orizzontale:
         Material limita di default ogni scheda a 264dp, quindi su schermi larghi restavano strette al centro. -->
    <style name="Widget.IPTV.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabMaxWidth">0dp</item>
        <!-- Indicatore sottile e arrotondato, a tutta larghezza della scheda; sfondo trasparente, ripple contenuto -->
        <item name="tabIndicator">@drawable/tab_indicator</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabUnboundedRipple">false</item>
    </style>

    <style name="Widget.IPTV.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Small</item>
    </style>

    <style name="Widget.IPTV.CircularProgress" parent="Widget.Material3.CircularProgressIndicator">
        <item name="showAnimationBehavior">outward</item>
    </style>

    <style name="Widget.IPTV.LinearProgress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="showAnimationBehavior">outward</item>
    </style>

    <style name="Theme.IPTV" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="tabStyle">@style/Widget.IPTV.TabLayout</item>
        <item name="snackbarStyle">@style/Widget.IPTV.Snackbar</item>
        <item name="circularProgressIndicatorStyle">@style/Widget.IPTV.CircularProgress</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.IPTV.LinearProgress</item>

        <!-- Palette: i valori chiaro/scuro stanno in values/colors.xml e values-night/colors.xml -->
        <item name="colorPrimary">@color/pez_accent</item>
        <item name="colorOnPrimary">@color/pez_on_accent</item>
        <item name="colorPrimaryContainer">@color/pez_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/pez_on_primary_container</item>
        <item name="colorSecondary">@color/pez_secondary</item>
        <item name="colorOnSecondary">@color/pez_on_secondary</item>
        <item name="colorSecondaryContainer">@color/pez_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/pez_on_secondary_container</item>
        <item name="colorTertiary">@color/pez_tertiary</item>
        <item name="colorOnTertiary">@color/pez_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/pez_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/pez_on_tertiary_container</item>
        <item name="colorError">@color/pez_error</item>
        <item name="colorOnError">@color/pez_on_error</item>

        <item name="android:colorBackground">@color/pez_background</item>
        <item name="colorOnBackground">@color/pez_text</item>
        <item name="colorSurface">@color/pez_surface</item>
        <item name="colorOnSurface">@color/pez_text</item>
        <item name="colorSurfaceVariant">@color/pez_card_menu</item>
        <item name="colorOnSurfaceVariant">@color/pez_text_secondary</item>
        <item name="colorOutline">@color/pez_outline</item>
        <item name="colorOutlineVariant">@color/pez_outline_variant</item>

        <!-- Lowest = barra del titolo, Low = card delle partite, il resto = card dei menu e finestre -->
        <item name="colorSurfaceContainerLowest">@color/pez_toolbar</item>
        <item name="colorSurfaceContainerLow">@color/pez_card_match</item>
        <item name="colorSurfaceContainer">@color/pez_card_menu</item>
        <item name="colorSurfaceContainerHigh">@color/pez_card_menu</item>
        <item name="colorSurfaceContainerHighest">@color/pez_card_menu</item>

        <item name="pezSelection">?attr/colorSecondaryContainer</item>
    </style>

    <!-- Nero AMOLED (tema scuro): sfondo e superfici di base a nero puro, senza toccare i colori d'accento.
         Le card (surfaceContainer e sopra) restano grigio scuro, così si distinguono dallo sfondo. -->
    <style name="ThemeOverlay.IPTV.PitchBlack" parent="">
        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="colorSurfaceContainerLowest">@android:color/black</item>
    </style>
</resources>
